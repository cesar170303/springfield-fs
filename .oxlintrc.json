{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "@supabase/*",
                  "**/application/**",
                  "**/infrastructure/**"
                ],
                "message": "ADR-0001: domain solo puede importar de domain."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react/*", "react-dom", "react-dom/*", "@supabase/*", "**/infrastructure/**"],
                "message": "ADR-0001: application solo puede importar de domain y application."
              }
            ]
          }
        ]
      }
    }
  ]
}
